{
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": true,
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"quoteProps": "as-needed",
	"trailingComma": "all",
	"singleAttributePerLine": false,
	"proseWrap": "preserve",
	"requirePragma": false,
	"insertPragma": false,
	"printWidth": 120,
	"tabWidth": 2,
	"useTabs": false,
	"embeddedLanguageFormatting": "auto",
	"endOfLine": "lf"
}
